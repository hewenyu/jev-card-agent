# Never commit real keys. Copy this file to .env for local configuration.
OPEN_POKER_API_KEY=
OPEN_POKER_WS_URL=wss://openpoker.ai/ws
OPEN_POKER_REST_BASE_URL=https://api.openpoker.ai
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=3000

# Optional reasoning provider. The default bot strategy remains pure Jev.
# The base URL includes /v1. Actual returned models must match requested models.
REASONING_API_KEY=
REASONING_API_BASE_URL=https://api.openai.com/v1
REASONING_API_FORMAT=responses
REASONING_MODEL=gpt-6-astra
REASONING_MESSAGES_MODEL=claude-opus-5
REASONING_TIMEOUT_MS=12000
HYBRID_TIMEOUT_MS=15000
# Configurable conservative estimates, NOT a verified proxy invoice or price quote.
REASONING_INPUT_PRICE_PER_MILLION=10
REASONING_OUTPUT_PRICE_PER_MILLION=50

# Conservative persistent usage ledger across runs; unknown requests retain reservations.
TOTAL_BUDGET_USD=9
RUN_BUDGET_USD=1

HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/jev.sqlite
DEMO_DATABASE_PATH=data/demo.sqlite
# Required for a public non-demo bind. Generate at least 24 random characters.
# Enter this token in the console Access settings; never put it in a URL.
API_TOKEN=
# Public synthetic data only; disables all writes, live runtime and provider credentials.
READ_ONLY_DEMO=false
# Optional anonymous read-only access to ended real hands; private/live data still needs API_TOKEN.
PUBLIC_HISTORY=false

# Opt-in autonomous participation after HTTP startup; restores from the same persistent DB.
# Demo/read-only demo always disables this. Image updates remain manual.
AUTO_START_BOT=false
BOT_STRATEGY=jev

# Run bounds and buy-in are explicit API/CLI arguments, not implicit environment toggles:
# npm run bot -- --strategy jev --max-hands 10 --max-minutes 30 --budget-usd 1
# Use --no-auto-rebuy to leave after busting; 0 for both limits means continuous runtime.
