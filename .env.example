# Copy to .env; never commit credentials or private evaluation protocols.
OPEN_POKER_API_KEY=
OPEN_POKER_WS_URL=wss://openpoker.ai/ws
OPEN_POKER_REST_BASE_URL=https://api.openpoker.ai

# Jev Score is the only live action model. Retries are fixed at three.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=10000
JEV_DECISION_TIMEOUT_MS=40000
DUELLOOP_EXECUTION_RESERVE_MS=1500

HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/jev.sqlite
DEMO_DATABASE_PATH=data/demo.sqlite
# Separate persisted facts and framework stores; blank paths derive from DATABASE_PATH.
FACTS_ENABLED=true
FACTS_DATABASE_PATH=
DUELLOOP_DATABASE_PATH=
# Keep these identities stable across restarts and manual image updates.
DUELLOOP_ACTOR_ID=openpoker-self
DUELLOOP_SCOPE_ID=
# Passed independent final evaluation is required; changes activate at the next new hand.
# Also supports explicit (operator approval) and candidate_only (no activation).
DUELLOOP_ACTIVATION_MODE=automatic_after_validation
# Historical archives only. No legacy live strategy/advice publisher is started.
KNOWLEDGE_DATABASE_PATH=
RESEARCH_DATABASE_PATH=

# Optional SDK research, isolated from live action execution.
# Use DUELLOOP_RESEARCH_* for this provider; REASONING_* belongs to legacy evaluation.
# DeepSeek and evaluation Jev credentials are allowlisted; the worker gets no Arena key.
# Enabling research requires both keys and validated private development/final protocols.
# Missing protocols leave research waiting_protocol while Jev continues playing.
DUELLOOP_RESEARCH_ENABLED=false
DUELLOOP_RESEARCH_API_KEY=
DUELLOOP_RESEARCH_BASE_URL=https://api.deepseek.com/anthropic
DUELLOOP_RESEARCH_MODEL=deepseek-flash
DUELLOOP_RESEARCH_THINKING=enabled
DUELLOOP_RESEARCH_EFFORT=high
DUELLOOP_RESEARCH_REQUEST_TIMEOUT_MS=60000
DUELLOOP_RESEARCH_MAX_OUTPUT_TOKENS=8192
DUELLOOP_RESEARCH_MAX_TOOL_TURNS=24
# Provider retries are fixed at three; tool turns are not network retry attempts.
DUELLOOP_DEVELOPMENT_PROTOCOL=data/protocols/development.json
DUELLOOP_FINAL_PROTOCOL=data/protocols/final.json
DUELLOOP_RESEARCH_SETTLED_HANDS=100
DUELLOOP_RESEARCH_COOLDOWN_MS=300000
DUELLOOP_RESEARCH_POLL_MS=5000
DUELLOOP_RESEARCH_SNAPSHOT_DECISIONS=500
DUELLOOP_RESEARCH_SNAPSHOT_HANDS=1000
DUELLOOP_RESEARCH_MAX_ROUNDS=2
# Operational task bounds, not monetary spending gates. Unknown dollar cost stays unknown.
DUELLOOP_RESEARCH_MAX_SECONDS=3600
DUELLOOP_RESEARCH_MAX_TOKENS=1000000
# SDK provider invocations; individual HTTP requests are audited separately.
DUELLOOP_RESEARCH_MAX_CALLS=12
DUELLOOP_EVALUATION_MAX_CALLS=10000
DUELLOOP_RESEARCH_MAX_REPAIRS=1

# Required for a public non-demo bind. Generate at least 24 random characters.
# Internal CLI/Compose management only; never put this token in the public website or URL.
API_TOKEN=
READ_ONLY_DEMO=false
# Anonymous read-only live/history views; mutations remain private and token-protected.
PUBLIC_HISTORY=false
AUTO_START_BOT=false
BOT_STRATEGY=jev

# Compose host binding; container service configuration is provided by compose.yaml.
BIND_ADDRESS=127.0.0.1
CONSOLE_PORT=8787

# Run bounds and buy-in are explicit API/CLI arguments:
# npm run bot -- --strategy jev --max-hands 10 --max-minutes 30
# --no-auto-rebuy leaves after busting; zero for both limits means continuous runtime.
# Retired ASYNC_LLM_*, LLM_ADVICE_*, LLM_RESEARCH_*, REASONING_MODE and HYBRID_TIMEOUT_MS
# are rejected by the live application. See docs/deployment.md for migration.
